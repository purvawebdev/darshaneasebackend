{
    "name": "darshanease-backend",
    "version": "1.0.0",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "seed": "ts-node src/scripts/seed-slot.ts",
        "seed:temples": "ts-node src/scripts/seedTemples.ts",
        "seed:slots": "ts-node src/scripts/seedSlots.ts",
        "seed:superadmin": "ts-node src/scripts/seedSuperAdmin.ts",
        "seed:all": "ts-node src/scripts/seedTemples.ts && ts-node src/scripts/seedSlots.ts && ts-node src/scripts/seedSuperAdmin.ts",
        "build": "tsc",
        "start": "node dist/server.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.9.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.7.0",
        "next-cloudinary": "^6.17.5",
        "nodemailer": "^8.0.4",
        "socket.io": "^4.8.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.7.4",
        "@types/nodemailer": "^7.0.11",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.6.2"
    }
}
